{
  "PreToolUse": [
    { "matcher": "Bash", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.claude/wol/spells/protect.sh\"", "timeout": 20, "statusMessage": "Protect: checking the command" }] },
    { "matcher": "Read|Edit|Write", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.claude/wol/spells/shell.sh\"", "timeout": 5 }] },
    { "matcher": "__SQL_TOOLS__", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.claude/wol/spells/silence.sh\"", "timeout": 5, "statusMessage": "Silence: checking the query" }] }
  ],
  "PostToolUse": [
    { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.claude/wol/spells/mini.sh\"", "timeout": 10 }] }
  ]
}
